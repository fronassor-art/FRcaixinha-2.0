APP_ENV=development
DATABASE_URL=postgresql+psycopg://frcaixinha:CHANGE_ME@db:5432/frcaixinha
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:8000
ACCESS_TOKEN_MINUTES=60
PASSWORD_RESET_MINUTES=30
SESSION_IDLE_MINUTES=30
WEBHOOK_SIGNATURE_MAX_AGE_SECONDS=300
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
LOAN_DAILY_PENALTY_RATE=0.00
WORKFLOW_EVIDENCE_STORAGE_ROOT=/code/data/workflow-evidence
WORKFLOW_EVIDENCE_MAX_BYTES=10485760
# Optional integrations:
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_WEBHOOK_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_STARTTLS=true

# Seeds are manual only and are always forbidden when APP_ENV=production.
# Set the exact opt-in only for an intentional local/test seed run.
# Never put real seed passwords or other secrets in this versioned file.
FRCAIXINHA_ENABLE_STANDARD_SEED=
FRCAIXINHA_SEED_ADMIN_PASSWORD=
# FRCAIXINHA_SEED_ADMIN_PASSWORD_FILE=
FRCAIXINHA_SEED_ADMIN_CPF=

FRCAIXINHA_ENABLE_HOMOLOGATION_SEED=
FRCAIXINHA_HOMOLOGATION_PASSWORD=
# FRCAIXINHA_HOMOLOGATION_PASSWORD_FILE=
# Provide only data appropriate for the target non-production environment.
# Homologation must not use a real participant's CPF. Never commit CPF values here.
FRCAIXINHA_HOMOLOGATION_CPF_1=
FRCAIXINHA_HOMOLOGATION_CPF_2=
FRCAIXINHA_HOMOLOGATION_CPF_3=
FRCAIXINHA_HOMOLOGATION_CPF_4=
FRCAIXINHA_HOMOLOGATION_CPF_5=
